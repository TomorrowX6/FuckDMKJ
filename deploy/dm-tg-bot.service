[Unit]
Description=DM Telegram activity bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dm-bot
Group=dm-bot
WorkingDirectory=/opt/dm-tg-bot/current
EnvironmentFile=/etc/dm-tg-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/dm-tg-bot
Environment=TZ=Asia/Shanghai
Environment=DM_BOT_DATA=/var/lib/dm-tg-bot
Environment=DM_BROWSER_EXECUTABLE=/usr/bin/chromium
ExecStart=/opt/dm-tg-bot/venv/bin/python -u /opt/dm-tg-bot/current/dm_bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=100
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dm-tg-bot
MemoryMax=4G
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
